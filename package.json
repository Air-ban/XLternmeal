{
  "name": "xlterm",
  "version": "1.0.0",
  "description": "A modern SSH terminal client",
  "main": "dist/main/index.js",
  "scripts": {
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --external:electron --external:ssh2 --outfile=dist/main/index.js --format=cjs",
    "build:preload": "esbuild src/main/preload.ts --bundle --platform=node --external:electron --outfile=dist/main/preload.js --format=cjs",
    "build:renderer": "esbuild src/renderer/index.tsx --bundle --platform=browser --outfile=dist/renderer/bundle.js",
    "build:html": "node scripts/copy-assets.js",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer && npm run build:html",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron ."
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/xterm": "^5.5.0",
    "marked": "^18.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ssh2": "^1.15.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/ssh2": "^1.15.0",
    "electron": "^28.0.0",
    "esbuild": "^0.19.0",
    "typescript": "^5.3.0"
  }
}
